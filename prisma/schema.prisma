generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookInactiveReason {
  MANUAL
}

model Book {
  id                  String              @id @default(uuid())
  title               String
  authorId            String
  isActive            Boolean             @default(true)
  inactiveReason      BookInactiveReason?
  isAvailableForLoan  Boolean             @default(true)
  description         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt

  author              Author @relation(fields: [authorId], references: [id])
  loans               Loan[]
}

model User {
  id                  String   @id @default(uuid())
  firstName           String
  lastName            String
  email               String   @unique
  phone               String   @unique
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  loans               Loan[]
}

model Author {
  id                  String   @id @default(uuid())
  firstName           String
  lastName            String
  email               String   @unique
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  books               Book[]
}

model Loan {
  id                  String    @id @default(uuid())
  userId              String
  bookId              String
  loanDate            DateTime  @default(now())
  returnDate          DateTime?

  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book                Book @relation(fields: [bookId], references: [id])
}
