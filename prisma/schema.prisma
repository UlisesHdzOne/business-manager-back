generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Customer {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  email      String    @unique
 
  orders     Order[]
}

model Order {
  id          String   @id @default(uuid())
  description String
  customerId  String
  
  customer    Customer @relation(fields: [customerId], references: [id])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}