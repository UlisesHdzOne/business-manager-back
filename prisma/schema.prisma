generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookInactiveReason {
  AUTHOR_INACTIVE
  MANUAL
}

model Book {
  id             String   @id @default(uuid())
  title          String
  authorId       String?
  active         Boolean  @default(true)
  inactiveReason BookInactiveReason?
  available      Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  author Author? @relation(fields: [authorId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Author {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  books Book[]
}
