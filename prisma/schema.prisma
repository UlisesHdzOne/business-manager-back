generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Customer {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  email      String    @unique
 
  orders     Order[]
}

model Order {
  id          String   @id @default(uuid())
  description String
  customerId  String
  
  customer    Customer @relation(fields: [customerId], references: [id])
  items       OrderItem[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}